{
  "info": {
    "name": "E-Commerce Cart & Order API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/clear",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "clear"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart Items",
      "item": [
        {
          "name": "Add Cart Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"replace-with-product-id\",\n    \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cart-item/add",
              "host": ["{{baseUrl}}"],
              "path": ["cart-item", "add"]
            }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cart-item/update/:cartItemId",
              "host": ["{{baseUrl}}"],
              "path": ["cart-item", "update", ":cartItemId"],
              "variable": [
                {
                  "key": "cartItemId",
                  "value": "replace-with-cart-item-id"
                }
              ]
            }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart-item/remove/:cartItemId",
              "host": ["{{baseUrl}}"],
              "path": ["cart-item", "remove", ":cartItemId"],
              "variable": [
                {
                  "key": "cartItemId",
                  "value": "replace-with-cart-item-id"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"John Doe\",\n    \"phone\": \"01700000000\",\n    \"address\": \"123 Main St\",\n    \"city\": \"Dhaka\",\n    \"postalCode\": \"1200\",\n    \"notes\": \"Leave at door\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/order/create",
              "host": ["{{baseUrl}}"],
              "path": ["order", "create"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["order", "my-orders"]
            }
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/:orderId",
              "host": ["{{baseUrl}}"],
              "path": ["order", ":orderId"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "replace-with-order-id"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": ["{{baseUrl}}"],
              "path": ["order"]
            }
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"processing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/order/:orderId/status",
              "host": ["{{baseUrl}}"],
              "path": ["order", ":orderId", "status"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "replace-with-order-id"
                }
              ]
            }
          }
        },
        {
          "name": "Update Payment Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentStatus\": \"paid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/order/:orderId/payment-status",
              "host": ["{{baseUrl}}"],
              "path": ["order", ":orderId", "payment-status"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "replace-with-order-id"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Order Items",
      "item": [
        {
          "name": "Get Order Items By Order ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order-item/order/:orderId",
              "host": ["{{baseUrl}}"],
              "path": ["order-item", "order", ":orderId"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "replace-with-order-id"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order Item By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order-item/:orderItemId",
              "host": ["{{baseUrl}}"],
              "path": ["order-item", ":orderItemId"],
              "variable": [
                {
                  "key": "orderItemId",
                  "value": "replace-with-order-item-id"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here"
    }
  ]
}
